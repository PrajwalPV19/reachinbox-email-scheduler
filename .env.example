# Node Environment & Server Ports
NODE_ENV=development
PORT=5000
WORKER_CONCURRENCY=5

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox_scheduler
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reachinbox_scheduler
POSTGRES_PORT=5432

# Redis Cache & Queue Backend
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Elasticsearch Search Engine
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_PORT=9200

# Rate Limiting & Scheduling Configurations
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=100

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Slack OAuth 2.0 & Notification Credentials
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:5000/slack/callback
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX

# Ethereal SMTP Fake Email Service (Created automatically if not provided)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=your-ethereal-user@ethereal.email
ETHEREAL_PASSWORD=your-ethereal-password

# Session & Security
JWT_SECRET=super_secret_reachinbox_jwt_signing_key_32chars_min
SESSION_SECRET=super_secret_session_reachinbox_key_32chars
FRONTEND_URL=http://localhost:3000
